{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "scripts": {
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "start-prod": "node server.js",
    "build": "npm run build --prefix client"
  }
}
